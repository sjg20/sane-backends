;
; SANE Backend specification file
;
; It's basically emacs-lisp --- so ";" indicates comment to end of line.
; All syntactic elements are keyword tokens, followed by a string or
;  keyword argument, as specified.
;
; ":backend" *must* be specified.
; All other information is optional (but what good is the file without it?).
;

:backend "finet"                  ; name of backend
:version "1"                      ; version of backend
:manpage "sane-finet"             ; name of manpage (if it exists)
:comment "Network interface of the Ricoh (formerly Fujitsu/PFU) fi-8000 series document scanners, using the HTTP/JSON protocol spoken by PaperStream IP Net"

:devicetype :scanner

:mfg "Ricoh"
:url "https://www.pfu.ricoh.com/global/scanners/fi/"

:model "fi-8950"
:interface "Ethernet"
:status :good
:comment "ADF, duplex, 50-600 dpi, lineart/greyscale/colour and JPEG pass-through; found automatically by network broadcast. Tested with an fi-8950"
